// Packages this project uses.
//
// plasma.openxr talks to the headset, plasma.xrtoolkit provides the hands, pointer, teleport and turning, and
// plasma.jolt is the physics the grabbable objects and the teleport surfaces use.

Package
{
	string %Id{"plasma.jolt"}
	string %Version{"1.3.2"}
}
Package
{
	string %Id{"plasma.openxr"}
	string %Version{"1.3.2"}
}
Package
{
	string %Id{"plasma.xrtoolkit"}
	string %Version{"1.0.0"}
}
